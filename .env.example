# ─────────────────────────────────────────────────────────────────────────────
# Sojourn — environment configuration
# Copy to `.env.local` for local dev. Supabase (URL + anon key) is REQUIRED —
# the app fails fast without it. Everything else is optional and gated by its
# own capability flag.
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SERVER ONLY — never expose to the browser) ---
# Used by admin/API routes that must bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection (SERVER ONLY) — for schema migrations ---
# The app never uses this: it talks to PostgREST with the keys above, and
# PostgREST cannot execute DDL. It is read only by `npm run migrate`, which runs
# automatically before every build and at container start so the schema can
# never fall behind the code (docs/adr/0002-updates-and-schema-migrations.md).
#
# Supabase → Project Settings → Database → Connection string → URI. Use the
# DIRECT connection (port 5432), not the transaction pooler on 6543 — the runner
# holds one advisory lock across every migration, and transaction pooling gives
# each statement a different backend.
#
# On Vercel the Supabase integration already sets POSTGRES_URL_NON_POOLING, and
# the runner picks that up on its own; you only need this for Docker or a
# bare-metal checkout. Leave it blank and migrations are skipped, loudly.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sojourn

# --- Embeddings (semantic / hybrid search) ---
# OpenAI-compatible /embeddings endpoint. DeepSeek has no embeddings API, so this
# is separate. Without it, search transparently falls back to full-text only.
# Point EMBEDDING_BASE_URL at Ollama / TEI / llama.cpp to self-host keylessly.
# If you change the model's dimensionality, also update vector(1536) in
# supabase/migrations/0010_hybrid_search.sql and re-run the backfill.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# Must match the DB vector() column (supabase/migrations/0010_hybrid_search.sql).
# This one stays env-only — a UI control here could silently corrupt search by
# not matching the column it was set up for. Note EMBEDDING_MODEL above IS
# editable from /admin/settings, so swapping to a model with a different native
# dimension without also migrating the column is a real footgun.
EMBEDDING_DIM=1536
AI_PRICE_EMBEDDING_USD=0.02

# ─── AI providers ────────────────────────────────────────────────────────────
# OPTIONAL, and settable from /admin/settings instead — a value stored there
# OVERRIDES the variable here (DB → env → built-in default). These are the
# fallback (and the way to seed a fresh deploy without touching the UI first).
# Without a DeepSeek key the AI features are simply off; the admin dashboard
# says so. The same key reaches both this app and the Supabase Edge Functions
# (supabase/functions/_shared/config.ts), which read the same app_secrets rows.
#
# Drafting. Any OpenAI-compatible chat endpoint works — point DEEPSEEK_BASE_URL
# at your own to self-host it.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_FAST=deepseek-v4-flash
# DEEPSEEK_MODEL_REASONER=deepseek-v4-pro
#
# Vision (photo descriptions). DeepSeek's API takes no image input, so this is a
# separate OpenAI-compatible chat endpoint. Falls back to the embeddings
# provider (key + base URL) when unset.
# VISION_API_KEY=
# VISION_BASE_URL=
# VISION_MODEL=gpt-4o-mini
#
# AI_PRICE_* (see above, under Embeddings) stays env-only (cost-meter display
# config, not user-facing provider selection, so deliberately out of scope).

# --- Map ---
# Keyless by default (OpenFreeMap). Override to use your own tile provider.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Where visitors can get the source of THIS deployment (AGPL §13). Leave unset
# if you run Sojourn unmodified — it defaults to the upstream repository. Change
# the code and you must point this at your own tree; it is read at runtime, so a
# prebuilt image needs no rebuild.
# SOURCE_URL=https://git.example.org/you/sojourn

# How long (minutes) a fresh install stays claimable at /admin/setup, measured
# from when the schema was installed. 0 disables the guard. Reopen a lapsed
# window with: update public.site_settings set setup_opened_at = now() where id = 1;
SETUP_WINDOW_MINUTES=60

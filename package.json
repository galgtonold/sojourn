{
  "name": "sojourn",
  "version": "0.2.1",
  "private": true,
  "description": "Sojourn — a bold, immersive travel journal. Next.js + Supabase, Docker-portable.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "notices": "node scripts/gen-notices.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ai:live": "RUN_LIVE_AI=1 vitest run test/e2e/live.test.ts",
    "test:rls": "vitest run test/e2e/rls.test.ts",
    "eval": "vitest run --config vitest.eval.config.mts",
    "gen:vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^2.0.1",
    "blurhash": "^2.0.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exifr": "^7.1.3",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^6.3.0",
    "next": "^15.5.23",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}

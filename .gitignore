# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — none are committed.
#
# .env.production used to be, holding only public values (the Supabase URL and
# anon key, the VAPID public key). Nothing secret, but it pinned ONE deployment's
# Supabase project into the repo — so anyone who cloned this and deployed before
# configuring got a site quietly reading the original author's database instead
# of the first-run setup screen. Those values now live in the deployment's own
# environment, where per-deployment config belongs.
.env
.env*.local
.env.production
# Per-instance secrets for the all-in-one stack: Postgres password, the JWT
# secret Supabase's services trust each other with, and the keys minted from
# it. Committing this hands anyone a service_role token for your database.
.env.selfhost

# vercel
.vercel

# typescript
*.tsbuildinfo

# supabase
/supabase/.branches
/supabase/.temp
/supabase/.env

# local data / uploads
/tmp
/.idea
/.vscode
coverage/

# eval harness (sourced trip data, runs, cache — never committed)
/eval/fixtures
/eval/runs
/eval/.cache

# database backups (private data + downloaded storage files — never committed)
/backups

# Demo fixtures: regenerated by scripts/demo/fetch-photos.mjs, not worth committing.
scripts/demo/photos/

# Working notes from the design/planning workflow. Useful while building, but
# they are process rather than product — kept locally, out of the public repo.
docs/superpowers/
.superpowers/

# Agent working memory and one-off review write-ups. None of this has ever been
# committed, and the only thing that was stopping it was a line in CLAUDE.md
# reminding whoever was staging not to use `git add -A`. That is a fine reminder
# and a poor control — especially once the repo is public and other people are
# staging things. memory/ holds business notes and a personal address.
memory/
docs/reviews/
docs/*-review.html
docs/security-audit.html
prod-licenses.txt

# Editor/agent local settings. .claude/launch.json is deliberately tracked (it
# is how the dev server gets started); nothing else in there should be.
.claude/*
!.claude/launch.json

# @vercel/analytics declares an *optional* @sveltejs/kit peer, which npm v7+'s
# strict resolver tries to satisfy and then conflicts with vitest's vite@5
# (it pulls vite@8). The peer isn't actually needed here, so fall back to the
# pre-v7 peer behaviour. All real dependencies are direct, so nothing is masked.
# This keeps local and Vercel installs identical.
legacy-peer-deps=true
